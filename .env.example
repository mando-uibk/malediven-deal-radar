# OpenAI Responses API (fuer Websuche und strukturierte Extraktion)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# E-Mail via Resend (https://resend.com)
SEND_EMAIL=false
RESEND_API_KEY=
EMAIL_FROM=Malediven Agent <angebote@deine-domain.at>
EMAIL_TO=freundin@example.com

# Optional
TRIP_CONFIG_PATH=config/trip.json
STATE_PATH=.data/state.json
REPORT_PATH=output/latest-report.html
SITE_PATH=site/index.html
FIXTURE_PATH=
